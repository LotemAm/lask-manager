{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs",
      "displayName": "Visual Studio 2026, x64",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/vs"
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config (run from a VS developer prompt)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ninja"
    }
  ],
  "buildPresets": [
    { "name": "vs-debug",   "configurePreset": "vs",    "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs",    "configuration": "Release" },
    { "name": "ninja-debug",   "configurePreset": "ninja", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" }
  ]
}
